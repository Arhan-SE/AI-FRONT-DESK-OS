# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- OpenAI: voice (Realtime), reasoning (gpt-4o-mini), embeddings ---
OPENAI_API_KEY=

# --- LiveKit: self-hosted, runs locally via `make livekit` ---
# `livekit-server --dev` binds ws://localhost:7880 with these well-known dev
# credentials. Media never leaves the machine, so the voice demo needs no
# LiveKit account and no internet for transport.
# These are PUBLIC development credentials. Never reuse them on a public host.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Supabase ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (Session pooler) used by asyncpg
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Telegram Bot API (long polling, no public URL needed) ---
TELEGRAM_BOT_TOKEN=

# --- Application ---
BUSINESS_TIMEZONE=Asia/Kolkata
DEMO_BUSINESS_ID=00000000-0000-0000-0000-000000000001
API_BASE_URL=http://localhost:8000

# --- Frontend (Vite: only VITE_* reaches the browser) ---
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
VITE_LIVEKIT_URL=ws://localhost:7880
